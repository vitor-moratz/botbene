# Copie este arquivo para backend/.env e preencha. O .env nunca vai para o git.

# Login da IQ Option
IQ_EMAIL=seu-email@exemplo.com
IQ_PASSWORD=sua-senha

# Conta usada pelo bot. Comece SEMPRE em PRACTICE (demo).
IQ_ACCOUNT=PRACTICE

# Trava de segurança: a conta REAL só pode ser usada se isto for true.
IQ_ALLOW_REAL=false

# Pasta para velas baixadas, relatórios e banco local
DATA_DIR=../data
